# ===== App =====
NODE_ENV=development
PORT=3000

# ===== Database =====
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=your_db_name

# ===== JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") =====
JWT_AT_SECRET=change_me_at_least_32_chars
JWT_RT_SECRET=change_me_at_least_32_chars
JWT_AT_EXPIRES_IN=900
JWT_RT_EXPIRES_IN=604800

# ===== Security =====
BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
THROTTLE_TTL=60
THROTTLE_LIMIT=10